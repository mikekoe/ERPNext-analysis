            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper

def response = new JsonSlurper().parseText(prev.getResponseDataAsString())

if (response.docstatus != 1) {
    throw new AssertionError(
        &quot;Stock Entry submission failed. Expected docstatus 1, got: ${response.docstatus}&quot;
    )
}

log.info(&quot;Stock Entry ${response.name} submitted successfully.&quot;)</stringProp>
