import groovy.json.JsonOutput

def response = new JsonSlurper().parseText(prev.getResponseDataAsString())

if (!response.message || response.message.doctype != &apos;Stock Entry&apos;) {
    throw new Exception(&apos;Expected a generated Stock Entry document&apos;)
}

