            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput

def response = new JsonSlurper().parseText(
    prev.getResponseDataAsString()
)

if (!response.message || response.message.doctype != &apos;Stock Entry&apos;) {
    throw new Exception(&apos;Expected a generated Manufacture Stock Entry&apos;)
}

if (response.message.purpose != &apos;Manufacture&apos;) {
    throw new Exception(&apos;Expected Stock Entry purpose Manufacture&apos;)
}

vars.put(
    &apos;manufacture_doc&apos;,
    JsonOutput.toJson(response.message)
)

log.info(&apos;Manufacture Stock Entry generated successfully&apos;)</stringProp>
          </JSR223PostProcessor>
